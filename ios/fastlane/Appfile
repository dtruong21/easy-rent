# iOS — renseigné via variables d'env (jamais en dur / jamais commité).
# BLOQUÉ tant que le compte Apple Developer (payant) n'existe pas.
app_identifier("com.daki.baillan")
apple_id(ENV["FASTLANE_APPLE_ID"])       # email du compte Apple Developer
itc_team_id(ENV["ASC_TEAM_ID"])          # App Store Connect team id
team_id(ENV["APPLE_DEV_TEAM_ID"])        # Developer Portal team id (10 car.)
