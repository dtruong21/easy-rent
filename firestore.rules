rules_version = '2';

// EasyRent — Firestore security rules.
//
// Firestore Security Rules — deny-by-default, ownership, immuabilité (FEAT-019).
// Référence : docs/plans/FEAT-019-firestore-rules.md
//
// Stratégie 3 couches :
//   1. Rules (ce fichier)         — ownership self + immutabilité de base + soft-delete filter
//   2. Callable Cloud Functions   — toutes les mutations cross-entity (lease, payment, receipt,
//                                   document), soft-delete (qui touche deletedAt), generate/void
//                                   receipt, mark sent.
//   3. Triggers Firestore         — setUpdatedAt, recomputeReceiptStale, denorm propagation.
//
// Convention : les rules bloquent tout par défaut. Chaque collection liste explicitement
// les opérations autorisées. Quand `if false`, la seule voie d'accès est une Callable
// Cloud Function avec Admin SDK (qui bypasse les rules).

service cloud.firestore {
  match /databases/{database}/documents {

    // ====================================================================
    // Helpers
    // ====================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    // BAILLAN-M1 — Firebase Anonymous Auth (« essai sans compte »). Le
    // provider de sign-in est exposé dans le custom claim standard
    // `firebase.sign_in_provider` du token ID.
    function isAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // OWASP-02 — email de confiance : vérifié (`email_verified`, posé par
    // Firebase Auth après clic sur le lien reçu) OU provider dont l'email est
    // vérifié par le fournisseur d'identité (Google, Apple). Avant ce garde-fou,
    // seul le client Flutter imposait la vérification (routeur + déconnexion
    // forcée à la connexion) : un compte email/mot de passe jamais vérifié
    // utilisait tout le produit via le SDK/REST. `get()` : le claim est absent
    // des tokens anonymes et de certains providers — un accès direct ferait
    // échouer l'évaluation (donc refuser) au lieu de retomber sur `false`.
    function hasTrustedEmail() {
      return request.auth.token.get('email_verified', false) == true
        || request.auth.token.firebase.sign_in_provider in ['google.com', 'apple.com'];
    }

    // Compte complet : signé, pas anonyme ET email de confiance (email/password
    // vérifié, Google, Apple). Toutes les collections métier (properties,
    // tenants, leases, payments, receipts, documents) sont réservées à
    // isFullyAuthed() — un anonyme ne peut PAS y écrire (seul le simulateur lui
    // est ouvert), pas plus qu'un compte email/mot de passe non vérifié.
    function isFullyAuthed() {
      return isSignedIn() && !isAnonymous() && hasTrustedEmail();
    }

    // Propriétaire d'un doc : même uid, ET session « de confiance » — soit un
    // compte anonyme (essai sans compte, régi par ses propres rules), soit un
    // compte à email de confiance. Un compte email/mot de passe NON vérifié
    // n'est donc propriétaire de rien : ni lecture, ni écriture (OWASP-02).
    // Seule exception, assumée et locale : la création de son propre doc
    // `landlords/{uid}` à l'inscription (cf. match /landlords ci-dessous).
    function isOwner(landlordId) {
      return isSignedIn()
        && request.auth.uid == landlordId
        && (isAnonymous() || hasTrustedEmail());
    }

    function isActive(rsc) {
      return rsc.data.deletedAt == null;
    }

    // Garde-fou commun aux update : landlordId, createdAt, deletedAt jamais touchés
    // côté client (les soft-delete et transferts éventuels passent par Callable).
    function preservesImmutables(rsc) {
      return request.resource.data.landlordId == rsc.data.landlordId
        && request.resource.data.createdAt == rsc.data.createdAt
        && request.resource.data.deletedAt == rsc.data.deletedAt;
    }

    // ====================================================================
    // landlords/{uid}   — docId = Firebase Auth UID
    // ====================================================================
    match /landlords/{uid} {
      // `resource == null` : un owner peut constater que SON doc n'existe
      // pas encore (get → exists=false). Indispensable au pattern
      // get-then-create des provisionings client (anonyme, Google, Apple) —
      // sans ça, isActive(resource) accède resource.data sur null → erreur
      // → deny, et le create qui suit n'est jamais tenté.
      allow get: if isOwner(uid) && (resource == null || isActive(resource));
      allow list: if false; // chaque user ne voit que son propre doc

      // CREATE (compte complet) : autorisé côté client juste après
      // createUserWithEmailAndPassword, avec consent RGPD obligatoire dans
      // le même write (atomicité art. 7.1). Identity Platform
      // `beforeUserCreated` peut fournir une seconde couche
      // (defense-in-depth) si activé — `set({merge:true})` rend les 2
      // chemins idempotents. Si IP désactivée, c'est ce chemin qui crée le
      // doc.
      //
      // OWASP-02 — EXCEPTION volontaire à isFullyAuthed()/isOwner() : à
      // l'inscription email/mot de passe, `signUpWithPassword` écrit ce doc
      // AVANT d'envoyer l'email de vérification puis de déconnecter
      // l'utilisateur, donc alors que `email_verified == false`. On exige
      // « non anonyme + propre uid » (+ les mêmes contraintes de champs
      // qu'avant) ; rien d'autre n'est accessible à ce compte tant qu'il n'a
      // pas vérifié son email.
      allow create: if isSignedIn()
        && !isAnonymous()
        && request.auth.uid == uid
        && request.resource.data.id == uid
        && request.resource.data.email is string
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.rgpdConsentVersion is string
        && request.resource.data.rgpdConsentVersion.size() > 0
        && request.resource.data.rgpdConsentAt is timestamp
        && request.resource.data.isAnonymous == false
        // FEAT-044 (CRITIQUE) : le doc landlord est provisionné côté client —
        // figer le tier à 'free' à la création empêche un client modifié de
        // s'auto-déclarer 'paid' et de lever le plafond de biens. Tout passage
        // à 'paid' doit venir d'un chemin serveur de confiance (webhook
        // paiement / CF Admin SDK), jamais d'un write client.
        && request.resource.data.subscriptionTier == 'free'
        && request.resource.data.deletedAt == null
        // FEAT-044 : compteur de biens honnête à la création (0 ou absent) —
        // empêche d'initialiser un compteur négatif pour contourner le gate.
        && request.resource.data.get('activePropertiesCount', 0) == 0
        && request.resource.data.get('activeTenantsCount', 0) == 0
        && request.resource.data.get('activeLeasesCount', 0) == 0
        // FEAT-056 : le provisioning est 100 % client — on ferme la porte à la
        // CRÉATION, pas seulement à la mise à jour. `subscriptionTier` est déjà
        // contraint à 'free' ci-dessus, mais un doc provisionné avec
        // `planLevel: 'ultra'` serait une bombe à retardement le jour où un
        // chemin de lecture ferait confiance au palier seul.
        && request.resource.data.get('planLevel', null) == null
        && !request.resource.data.keys().hasAny(['entitlements']);

      // CREATE (anonyme, BAILLAN-M1) : defense-in-depth — en pratique le
      // doc est provisionné par la Cloud Function `handleNewUser`
      // (beforeUserCreated, Admin SDK, bypasse les rules). Ce chemin
      // n'existe que si Identity Platform blocking functions est désactivé
      // ET permet au client de recréer un doc anonyme cohérent : PAS de
      // `rgpdConsentAt` (l'anonyme n'a rien signé), `email`/`fullName`
      // vides par construction.
      allow create: if isAnonymous()
        && request.auth.uid == uid
        && request.resource.data.id == uid
        && request.resource.data.email == null
        && request.resource.data.fullName == ''
        && request.resource.data.isAnonymous == true
        && request.resource.data.subscriptionTier == 'anonymous'
        && request.resource.data.anonExpiresAt is timestamp
        && request.resource.data.rgpdConsentAt == null
        && request.resource.data.deletedAt == null
        // FEAT-044 : idem — compteur de biens honnête (0 ou absent) à la création.
        && request.resource.data.get('activePropertiesCount', 0) == 0
        && request.resource.data.get('activeTenantsCount', 0) == 0
        && request.resource.data.get('activeLeasesCount', 0) == 0
        // FEAT-056 : un anonyme ne peut de toute façon pas être payant (le
        // webhook l'ignore), mais la défense en profondeur coûte deux lignes.
        && request.resource.data.get('planLevel', null) == null
        && !request.resource.data.keys().hasAny(['entitlements']);

      // UPDATE (compte complet) : profil propre. RGPD consent versionné,
      // identifiants et `subscriptionTier`/`isAnonymous` immuables côté
      // client (seule la Callable `finalizeAnonymousUpgrade`, via Admin
      // SDK, peut faire transitionner un tier — bypass des rules).
      allow update: if isFullyAuthed()
        && isOwner(uid)
        && isActive(resource)
        && request.resource.data.id == resource.data.id
        // PAS preservesImmutables() ici : le helper exige `landlordId`,
        // champ que landlords ne porte pas (sa clé est `id`) — l'accès à un
        // champ absent fait échouer la rule et refusait TOUT update. On
        // inline les immuables pertinents pour cette collection.
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.deletedAt == resource.data.deletedAt
        && request.resource.data.rgpdConsentAt == resource.data.rgpdConsentAt
        && request.resource.data.rgpdConsentVersion == resource.data.rgpdConsentVersion
        && request.resource.data.subscriptionTier == resource.data.subscriptionTier
        && request.resource.data.isAnonymous == resource.data.isAnonymous
        // FEAT-044 : compteur de biens maintenu par CF uniquement — le client
        // ne peut jamais le muter (sinon reset → création illimitée).
        && request.resource.data.get('activePropertiesCount', 0) == resource.data.get('activePropertiesCount', 0)
        && request.resource.data.get('activeTenantsCount', 0) == resource.data.get('activeTenantsCount', 0)
        && request.resource.data.get('activeLeasesCount', 0) == resource.data.get('activeLeasesCount', 0)
        // FEAT-044f (audit sécurité) : les champs `pro*` sont écrits
        // EXCLUSIVEMENT par le webhook RevenueCat / reconcile (Admin SDK, qui
        // bypasse les rules). Le client ne les LIT que. Les geler empêche : (a)
        // de neutraliser le backstop `reconcileEntitlements`
        // (`proEntitlementActive`/`proExpiresAt` pilotent sa query + son filtre),
        // et (b) de bloquer les futurs events légitimes via le garde d'ordre
        // `proLastEventAtMs` (`eventTs < lastTs` ⇒ stale) en le stampant très haut.
        && request.resource.data.get('proEntitlementActive', false) == resource.data.get('proEntitlementActive', false)
        && request.resource.data.get('proWillRenew', false) == resource.data.get('proWillRenew', false)
        && request.resource.data.get('proExpiresAt', null) == resource.data.get('proExpiresAt', null)
        && request.resource.data.get('proStore', '') == resource.data.get('proStore', '')
        && request.resource.data.get('proProductId', '') == resource.data.get('proProductId', '')
        && request.resource.data.get('proSince', null) == resource.data.get('proSince', null)
        && request.resource.data.get('proLastEventAtMs', 0) == resource.data.get('proLastEventAtMs', 0)
        // FEAT-056 : le palier commercial et l'état des entitlements sont
        // écrits EXCLUSIVEMENT par revenueCatWebhook / reconcileEntitlements
        // (Admin SDK, qui bypasse les rules). Même raisonnement que les champs
        // pro*, avec un enjeu PLUS élevé : hier forcer `subscriptionTier:
        // 'paid'` était le seul gain possible ; demain `planLevel: 'ultra'` est
        // un gain gradué, donc une cible plus attractive. Le client n'a JAMAIS
        // besoin d'écrire son palier — pas même pour l'affichage optimiste
        // post-checkout, qui doit attendre le webhook.
        && request.resource.data.get('planLevel', null) == resource.data.get('planLevel', null)
        && request.resource.data.get('entitlements', {}) == resource.data.get('entitlements', {});

      // UPDATE (anonyme, BAILLAN-M1) : limité aux champs que le renewer
      // d'expiration et l'app cliente ont besoin de toucher — jamais
      // `rgpdConsentAt`/`Version` (l'anonyme ne consent jamais côté client),
      // jamais `subscriptionTier` (seule la Callable finalize peut upgrader).
      allow update: if isAnonymous()
        && isOwner(uid)
        && isActive(resource)
        && resource.data.isAnonymous == true
        && request.resource.data.id == resource.data.id
        && request.resource.data.email == null
        && request.resource.data.fullName == ''
        && request.resource.data.isAnonymous == true
        && request.resource.data.subscriptionTier == 'anonymous'
        && request.resource.data.anonExpiresAt is timestamp
        // Borne supérieure sur anonExpiresAt : un anon ne peut pas se
        // stamper une expiration en l'an 9999 pour échapper au cron.
        // Autorisé = now + 15 jours max (marge d'1j vs le renouvellement
        // 14j côté client pour tolérer les décalages d'horloge).
        && request.resource.data.anonExpiresAt < request.time + duration.value(15, 'd')
        && request.resource.data.rgpdConsentAt == null
        // Même raison que la rule UPDATE compte complet : pas de
        // preservesImmutables() sur landlords (pas de champ landlordId).
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.deletedAt == resource.data.deletedAt
        // FEAT-044 : compteur de biens jamais muté côté client (CF only).
        && request.resource.data.get('activePropertiesCount', 0) == resource.data.get('activePropertiesCount', 0)
        && request.resource.data.get('activeTenantsCount', 0) == resource.data.get('activeTenantsCount', 0)
        && request.resource.data.get('activeLeasesCount', 0) == resource.data.get('activeLeasesCount', 0)
        // FEAT-044f : mêmes champs `pro*` gelés que la rule compte-complet
        // (webhook/reconcile-only). Un anonyme n'en porte jamais, mais on gèle
        // par cohérence et défense en profondeur (aucun no-op de sécurité).
        && request.resource.data.get('proEntitlementActive', false) == resource.data.get('proEntitlementActive', false)
        && request.resource.data.get('proWillRenew', false) == resource.data.get('proWillRenew', false)
        && request.resource.data.get('proExpiresAt', null) == resource.data.get('proExpiresAt', null)
        && request.resource.data.get('proStore', '') == resource.data.get('proStore', '')
        && request.resource.data.get('proProductId', '') == resource.data.get('proProductId', '')
        && request.resource.data.get('proSince', null) == resource.data.get('proSince', null)
        && request.resource.data.get('proLastEventAtMs', 0) == resource.data.get('proLastEventAtMs', 0)
        // FEAT-056 : le palier commercial et l'état des entitlements sont
        // écrits EXCLUSIVEMENT par revenueCatWebhook / reconcileEntitlements
        // (Admin SDK, qui bypasse les rules). Même raisonnement que les champs
        // pro*, avec un enjeu PLUS élevé : hier forcer `subscriptionTier:
        // 'paid'` était le seul gain possible ; demain `planLevel: 'ultra'` est
        // un gain gradué, donc une cible plus attractive. Le client n'a JAMAIS
        // besoin d'écrire son palier — pas même pour l'affichage optimiste
        // post-checkout, qui doit attendre le webhook.
        && request.resource.data.get('planLevel', null) == resource.data.get('planLevel', null)
        && request.resource.data.get('entitlements', {}) == resource.data.get('entitlements', {});

      // Soft-delete via Callable `softDeleteLandlord`. La purge des comptes
      // anonymes expirés passe par la Cloud Function planifiée
      // `cleanupExpiredAnon` (Admin SDK, bypasse les rules).
      allow delete: if false;
    }

    // ====================================================================
    // properties/{id}   — CRUD direct (pas de cross-entity)
    // ====================================================================
    match /properties/{id} {
      allow get: if isOwner(resource.data.landlordId) && isActive(resource);
      // AUDIT FEAT-045 : les rules ne sont PAS des filtres — `isSignedIn()`
      // laissait n'importe quel compte signé requêter les données d'un autre
      // landlord en fournissant son UID. `isOwner(resource.data.landlordId)`
      // force statiquement toute query à porter la contrainte
      // `where('landlordId', '==', request.auth.uid)` (déjà le cas de toutes
      // les requêtes de l'app). Pas d'isActive : le filtrage soft-delete
      // reste un choix de requête du propriétaire, pas un enjeu d'accès.
      allow list: if isOwner(resource.data.landlordId);

      // FEAT-044 : création CF-exclusive via la Callable `createProperty`
      // (Admin SDK, bypasse les rules) — elle impose le plafond free-tier et
      // maintient `landlords.activePropertiesCount`. Le client ne crée plus de
      // bien en direct : sinon il contournerait le gate de plan (les rules ne
      // peuvent ni agréger ni réserver atomiquement).
      allow create: if false;

      allow update: if isFullyAuthed()
        && isOwner(resource.data.landlordId)
        && isActive(resource)
        && preservesImmutables(resource)
        // activeLeaseCount n'est jamais touché par le client (denorm CF only).
        && request.resource.data.activeLeaseCount == resource.data.activeLeaseCount;

      allow delete: if false;
    }

    // ====================================================================
    // tenants/{id}   — CRUD direct
    // ====================================================================
    match /tenants/{id} {
      allow get: if isOwner(resource.data.landlordId) && isActive(resource);
      // Cf. commentaire properties (audit FEAT-045) : list owner-scoped.
      allow list: if isOwner(resource.data.landlordId);

      // FEAT-044 : création CF-exclusive via la Callable `createTenant`
      // (Admin SDK) — elle impose le plafond free-tier et maintient
      // `landlords.activeTenantsCount`. Cf. properties/create.
      allow create: if false;

      allow update: if isFullyAuthed()
        && isOwner(resource.data.landlordId)
        && isActive(resource)
        && preservesImmutables(resource)
        && request.resource.data.activeLeaseCount == resource.data.activeLeaseCount;

      allow delete: if false;
    }

    // ====================================================================
    // leases/{id}   — CROSS-ENTITY → CF exclusive
    //
    // Création/modification doivent valider que propertyId et tenantId
    // appartiennent au même landlord (auth.uid). Impossible dans les rules
    // (2× get() coûteux + impossible de checker que les denorms sont les bonnes).
    // ====================================================================
    match /leases/{id} {
      allow get: if isOwner(resource.data.landlordId) && isActive(resource);
      // Cf. commentaire properties (audit FEAT-045) : list owner-scoped.
      allow list: if isOwner(resource.data.landlordId);

      // Tout passe par Callable `createLease`, `updateLease`, `softDeleteLease`.
      allow create, update, delete: if false;
    }

    // ====================================================================
    // payments/{id}   — CROSS-ENTITY (lease.landlordId) → CF exclusive
    // ====================================================================
    match /payments/{id} {
      allow get: if isOwner(resource.data.landlordId) && isActive(resource);
      // Cf. commentaire properties (audit FEAT-045) : list owner-scoped.
      allow list: if isOwner(resource.data.landlordId);

      allow create, update, delete: if false;
    }

    // ====================================================================
    // receipts/{id}   — IMMUABLES (loi 6 juillet 1989) → CF exclusive
    //
    // Pas de soft-delete (rétention légale 5 ans). Pas de filtrage isActive
    // en read : les receipts voided restent lisibles pour audit.
    // ====================================================================
    match /receipts/{id} {
      allow get: if isOwner(resource.data.landlordId);
      // Cf. commentaire properties (audit FEAT-045) : list owner-scoped.
      // Doublement critique ici : les quittances d'un compte SUPPRIMÉ sont
      // conservées 5 ans (FEAT-045) — l'UID orphelin ne doit résoudre pour
      // personne (la promesse « archivée et inaccessible » du flux et de la
      // privacy policy v1.2 repose sur cette rule).
      allow list: if isOwner(resource.data.landlordId);

      // generateReceipt / voidReceipt / markReceiptAsSent en Callable.
      allow create, update, delete: if false;
    }

    // ====================================================================
    // charge_statements/{id} — IMMUABLES (loi 6 juillet 1989) → CF exclusive
    //
    // Décompte de régularisation figé (FEAT-033). Pas de soft-delete côté
    // client : tant que le compte existe, les décomptes annulés (isVoided)
    // restent lisibles pour audit. Contrairement aux quittances, ils ne sont
    // PAS conservés après la suppression du compte : `deleteAccount` les
    // supprime définitivement (hard-delete, RGPD art. 17 — cf.
    // PURGED_COLLECTIONS), de même que `etat_des_lieux`. Owner-scoped en get ET
    // list (mêmes garanties que receipts).
    // ====================================================================
    match /charge_statements/{id} {
      allow get:  if isOwner(resource.data.landlordId);
      allow list: if isOwner(resource.data.landlordId);
      // finalize / void / markAsSent en Callable.
      allow create, update, delete: if false;
    }

    // ====================================================================
    // etat_des_lieux/{id} — IMMUABLES (loi 6/7/1989, décret 2016-382) → CF
    // exclusive
    //
    // État des lieux figé (FEAT-037). Owner-scoped en get ET list, comme
    // receipts/charge_statements. Création via callable createEtatDesLieux.
    // ====================================================================
    match /etat_des_lieux/{id} {
      allow get:  if isOwner(resource.data.landlordId);
      allow list: if isOwner(resource.data.landlordId);
      allow create, update, delete: if false;
    }

    // ====================================================================
    // documents/{id}   — CF exclusive (legalHold dérivé de category)
    // ====================================================================
    match /documents/{id} {
      allow get: if isOwner(resource.data.landlordId) && isActive(resource);
      // Cf. commentaire properties (audit FEAT-045) : list owner-scoped.
      allow list: if isOwner(resource.data.landlordId);

      // createDocument calcule legalHold côté serveur depuis category.
      // softDeleteDocument refuse si legalHold == true.
      allow create, update, delete: if false;
    }

    // ====================================================================
    // expenses/{id}   — CROSS-ENTITY (property + lease optionnel) → CF exclusive
    //
    // FEAT-041a. Création/modification doivent valider que propertyId
    // (obligatoire) et leaseId (optionnel) appartiennent au même landlord,
    // ET dériver/valider `category` depuis `nature` (garde-fou juridique
    // décret 87-713, cf. docs/plans/FEAT-041-depenses.md §b). Impossible à
    // exprimer proprement dans les rules — même famille que leases/payments.
    // ====================================================================
    match /expenses/{id} {
      allow get: if isOwner(resource.data.landlordId) && isActive(resource);
      // Cf. commentaire properties (audit FEAT-045) : list owner-scoped.
      allow list: if isOwner(resource.data.landlordId);

      // Tout passe par Callable `createExpense`/`updateExpense` +
      // `softDeleteEntity`. Un anonyme n'accède jamais au registre de
      // dépenses (flux isFullyAuthed uniquement, comme properties/leases).
      allow create, update, delete: if false;
    }

    // ====================================================================
    // investment_scenarios/{id}   — création CF-exclusive, update direct
    // ====================================================================
    match /investment_scenarios/{id} {
      allow get: if isOwner(resource.data.landlordId) && isActive(resource);
      // Cf. commentaire properties (audit FEAT-045) : list owner-scoped.
      allow list: if isOwner(resource.data.landlordId);

      // FEAT-056 (PR-2b) : création CF-exclusive via la Callable
      // `createScenario` (Admin SDK, bypasse les rules) — elle impose le
      // plafond de scénarios du palier (`quotaLimit(plan, 'scenarios')`).
      // C'était le DERNIER quota appliqué par le client seul : le nombre de
      // scénarios devenant un différenciateur commercial entre Pro, Max et
      // Ultra, un plafond non vérifié serveur serait contournable en écrivant
      // le document soi-même. Les rules ne savent ni compter ni agréger, d'où
      // la callable. La validation de forme que faisait cette rule vit
      // désormais dans `parseScenarioInputs` (functions/src/callable/scenarios.ts).
      allow create: if false;

      allow update: if isOwner(resource.data.landlordId)
        && isActive(resource)
        && preservesImmutables(resource);

      allow delete: if false;
    }

    // ====================================================================
    // paid_plan_interest/{uid}   — docId = Firebase Auth UID (BAILLAN-M1)
    //
    // Marque d'intérêt pour le futur Plan Pro. Réservé aux comptes complets
    // (un anonyme n'a pas encore vu la proposition de valeur du produit —
    // le CTA "M'avertir" n'est jamais montré aux anons côté UI).
    // ====================================================================
    match /paid_plan_interest/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;

      allow create, update: if isFullyAuthed()
        && isOwner(uid)
        && request.resource.data.features is list;

      allow delete: if false;
    }

    // ====================================================================
    // support_requests/{id}   — CREATE-ONLY (FEAT-025)
    //
    // Formulaire « Nous contacter ». Le client écrit une demande à son
    // propre nom ; il ne relit JAMAIS (pas de back-office in-app en V1).
    // Traitement (notification email, triage) via Admin SDK / console.
    // ====================================================================
    match /support_requests/{id} {
      allow get, list: if false;   // l'utilisateur ne relit pas ses demandes en V1

      // Demande de support (FEAT-025) : pas de `kind`, message non vide.
      function isSupportRequest(d) {
        return !('kind' in d) && d.message.size() > 0;
      }

      // Avis (FEAT-060) : note entière 1-5, plateforme connue, commentaire
      // facultatif. Aucun renvoi vers les stores selon la note.
      function isFeedback(d) {
        return d.kind == 'feedback'
          && d.rating is int
          && d.rating >= 1
          && d.rating <= 5
          && d.platform in ['web', 'ios', 'android'];
      }

      allow create: if isFullyAuthed()
        && request.resource.data.landlordId == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000
        && request.resource.data.appVersion is string
        && request.resource.data.appEnv is string
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && (isSupportRequest(request.resource.data)
            || isFeedback(request.resource.data));

      allow update, delete: if false;
    }

    // ====================================================================
    // _ops — configuration lue UNIQUEMENT par les Cloud Functions (Admin SDK)
    // FEAT-044e : `_ops/sandboxAllowlist` (uids prod autorisés à recevoir un
    // droit via un achat sandbox). Aucun accès client, explicitement — le
    // fallback le refuse déjà, mais ouvrir ce chemin par erreur donnerait Pro
    // gratuit en s'auto-ajoutant à la liste.
    // ====================================================================
    match /_ops/{docId} {
      allow read, write: if false;
    }

    // ====================================================================
    // Fallback — tout le reste bloqué
    // ====================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
