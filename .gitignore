/android/app/release

# EasyRent — secrets et configs locales
.env
.env.local
.env.*.local
*.pem
*.key
secrets.json

# Dart-define values (contient les clés Supabase)
dart-defines.json
dart-defines.local.json
dart-defines.*.local.json
dart-defines.prod.json
dart-defines.dev.json
# Mais on garde les templates :
!dart-defines.example.json
!dart-defines.prod.example.json

# Patterns supplémentaires de secrets (defense in depth)
*-service-account.json
*serviceAccount*.json
*credentials*.json
!**/dart-defines.example.json
firebase-adminsdk-*.json

# Logs CI/CD potentiellement sensibles
*.ci.log
deploy-*.log

# Supabase local
supabase/.branches/
supabase/.temp/
supabase/.env

# Firebase
.firebase/
firebase-debug.log
firebase-debug.*.log

# Claude Code — paramètres locaux uniquement (settings.json est partagé)
.claude/settings.local.json
# Skills/agents Claude — installés localement via setup-cowork, pas du code projet
.agents/
.claude/skills/
skills-lock.json

# Generated Dart code
**/*.g.dart
**/*.freezed.dart
**/*.gr.dart
**/*.config.dart
**/*.mocks.dart

# gen_l10n output (FEAT-043) — régénéré via `flutter gen-l10n` / `flutter pub get`
lib/l10n/app_localizations*.dart
l10n_untranslated.json


# Backups (FEAT-019 migration)
backups/

# Config de preview locale (par développeur)
.claude/launch.json
