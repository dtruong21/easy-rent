#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# EasyRent — secrets et configs locales
.env
.env.local
.env.*.local
*.pem
*.key
secrets.json

# Dart-define values (config d'environnement)
dart-defines.json
dart-defines.local.json
dart-defines.*.local.json
dart-defines.prod.json
dart-defines.dev.json
dart-defines.emulator.json
# Mais on garde les templates :
!dart-defines.example.json
!dart-defines.prod.example.json
!dart-defines.emulator.example.json

# Patterns supplémentaires de secrets (defense in depth)
*-service-account.json
*serviceAccount*.json
*credentials*.json
!**/dart-defines.example.json
firebase-adminsdk-*.json

# Logs CI/CD potentiellement sensibles
*.ci.log
deploy-*.log

# Firebase
.firebase/
firebase-debug.log
firebase-debug.*.log

# Claude Code — paramètres locaux uniquement (settings.json est partagé)
.claude/settings.local.json
# Skills/agents Claude — installés localement via setup-cowork, pas du code projet
.agents/
.claude/skills/
skills-lock.json

# Generated Dart code
**/*.g.dart
# Exception (FEAT-056) : ce miroir n'est PAS produit par build_runner mais par
# tool/gen_entitlements.dart, qui n'est pas câblé dans l'étape « Generate code »
# de la CI. Ignoré, il serait absent d'un clone neuf et
# scripts/check-entitlements-parity.sh échouerait avant `flutter analyze`.
# Le committer rend en prime les changements de quotas visibles en revue de PR.
!lib/features/auth/domain/plan_matrix.g.dart
# Exception (vitrine Baillan, plan §1) : même raisonnement — ce miroir est
# produit par tool/gen_theme_tokens.dart, pas build_runner, et
# scripts/check-theme-tokens.sh a besoin de le trouver dans un clone neuf.
!lib/core/theme/app_palette.g.dart
**/*.freezed.dart
**/*.gr.dart
**/*.config.dart
**/*.mocks.dart

# gen_l10n output (FEAT-043) — régénéré via `flutter gen-l10n` / `flutter pub get`
lib/l10n/app_localizations*.dart
l10n_untranslated.json


# Backups (FEAT-019 migration)
backups/

# Config de preview locale (par développeur)
.claude/launch.json
firestore-debug.log

# Maquettes de brainstorming (visual companion) — local, jamais versionné
.superpowers/

# Site vitrine (Astro)
site/node_modules/
site/dist/
site/.astro/

# Graphe de connaissance local (/graphify) — régénérable, non versionné
graphify-out/
