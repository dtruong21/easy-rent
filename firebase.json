{
  "hosting": [
    {
      "target": "prod",
      "public": "build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/robots.staging.txt"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "//": "Entry points: jamais cachés — le browser doit toujours re-vérifier pour récupérer le dernier index.html / bootstrap / SW.",
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/flutter_bootstrap.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/flutter_service_worker.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/manifest.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "//": "SEO (FEAT-049) : robots.txt / sitemap.xml — cache court pour propager vite une bascule de domaine. Aucun glob suivant ne matche .txt/.xml, donc pas de collision de clé.",
          "source": "/robots.txt",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        },
        {
          "source": "/sitemap.xml",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        },
        {
          "//": "Flutter Web ne fingerprint AUCUN fichier : noms STABLES, contenus VARIABLES (main.dart.js à chaque build, canvaskit à chaque upgrade SDK, subsets d'icônes au gré du tree-shaking, manifests à chaque build). JAMAIS immutable ici — un contenu variable derrière un nom stable marqué immutable rend les deploys invisibles jusqu'à un hard refresh. Vécu deux fois : subsets d'icônes (icône Simulateur FEAT-018), puis flutter_bootstrap.js/main.dart.js servis immutable car cette règle, placée après, écrasait leur no-cache — Firebase applique la DERNIÈRE config matchante pour une clé donnée (2026-07-03). no-cache = revalidation ETag → 304 léger si inchangé, deploy servi immédiatement sinon.",
          "source": "**/*.@(js|wasm|mjs|json|bin|woff|woff2|ttf|otf)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.@(png|jpg|jpeg|gif|svg|ico|webp)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=2592000"
            }
          ]
        }
      ]
    },
    {
      "target": "stage",
      "public": "build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/robots.staging.txt"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "//": "Entry points: jamais cachés — le browser doit toujours re-vérifier pour récupérer le dernier index.html / bootstrap / SW.",
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/flutter_bootstrap.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/flutter_service_worker.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/manifest.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "//": "SEO (FEAT-049) : robots.txt / sitemap.xml — cache court pour propager vite une bascule de domaine. Aucun glob suivant ne matche .txt/.xml, donc pas de collision de clé.",
          "source": "/robots.txt",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        },
        {
          "source": "/sitemap.xml",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        },
        {
          "//": "Flutter Web ne fingerprint AUCUN fichier : noms STABLES, contenus VARIABLES (main.dart.js à chaque build, canvaskit à chaque upgrade SDK, subsets d'icônes au gré du tree-shaking, manifests à chaque build). JAMAIS immutable ici — un contenu variable derrière un nom stable marqué immutable rend les deploys invisibles jusqu'à un hard refresh. Vécu deux fois : subsets d'icônes (icône Simulateur FEAT-018), puis flutter_bootstrap.js/main.dart.js servis immutable car cette règle, placée après, écrasait leur no-cache — Firebase applique la DERNIÈRE config matchante pour une clé donnée (2026-07-03). no-cache = revalidation ETag → 304 léger si inchangé, deploy servi immédiatement sinon.",
          "source": "**/*.@(js|wasm|mjs|json|bin|woff|woff2|ttf|otf)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.@(png|jpg|jpeg|gif|svg|ico|webp)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=2592000"
            }
          ]
        }
      ]
    },
    {
      "target": "marketing",
      "public": "site/dist",
      "cleanUrls": true,
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "//": "Avec cleanUrls, Firebase route headers sur le CHEMIN demandé (/, /about), pas sur le fichier physique (index.html) : **/*.html ne matche donc jamais une clean URL et retombait sur le défaut Firebase (max-age=3600). ** attrape toutes les pages HTML aussi ; il reste placé AVANT /_astro/** et /{robots.txt,sitemap.xml} qui gagnent pour leurs chemins via la sémantique dernière-règle-matchante (cf. commentaire ligne ~76, bloc prod).",
          "source": "**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
        },
        {
          "source": "/_astro/**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
          "source": "/{robots.txt,sitemap.xml}",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
        }
      ]
    },
    {
      "target": "marketing-stage",
      "public": "site/dist",
      "cleanUrls": true,
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "**",
          "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
        },
        {
          "//": "Avec cleanUrls, **/*.html ne matche jamais une clean URL (Firebase route headers sur le chemin demandé, pas le fichier physique) — retombait sur le défaut Firebase (max-age=3600). ** couvre toute page HTML ; clé Cache-Control distincte du X-Robots-Tag de la règle précédente, donc les deux headers s'appliquent sans conflit.",
          "source": "**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
        }
      ]
    }
  ],
  "firestore": [
    {
      "database": "(default)",
      "location": "eur3",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    },
    {
      "database": "staging",
      "location": "eur3",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs20",
      "region": "europe-west1",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "auth": {
    "providers": {
      "anonymous": true,
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "EasyRent",
