{
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "//": "Entry points: jamais cachés — le browser doit toujours re-vérifier pour récupérer le dernier index.html / bootstrap / SW.",
        "source": "/index.html",
        "headers": [
          {"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}
        ]
      },
      {
        "source": "/flutter_bootstrap.js",
        "headers": [
          {"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}
        ]
      },
      {
        "source": "/flutter_service_worker.js",
        "headers": [
          {"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}
        ]
      },
      {
        "source": "/manifest.json",
        "headers": [
          {"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}
        ]
      },
      {
        "//": "JS/wasm + polices EB Garamond (assets bundlés au nom + contenu stables) — long cache immutable.",
        "source": "**/*.@(js|wasm|mjs|woff|woff2|ttf|otf)",
        "headers": [
          {"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}
        ]
      },
      {
        "//": "Polices d'ICÔNES Material/Cupertino : nom de fichier FIXE mais contenu VARIABLE (tree-shaking = seules les icônes utilisées sont incluses). JAMAIS immutable — sinon un ancien subset mis en cache masque toute icône ajoutée depuis (bug icône Simulateur, ajoutée en FEAT-018 mais absente d'un subset caché depuis FEAT-010 ; 2026-07-03). Revalidation ETag (no-cache) → 304 léger si inchangé. Règle placée APRÈS le glob immutable : Firebase applique la dernière config matchante pour une clé d'en-tête donnée.",
        "source": "**/@(MaterialIcons-Regular.otf|CupertinoIcons.ttf)",
        "headers": [
          {"key": "Cache-Control", "value": "no-cache"}
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|svg|ico|webp)",
        "headers": [
          {"key": "Cache-Control", "value": "public, max-age=2592000"}
        ]
      }
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "eur3",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs20",
      "region": "europe-west1",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "auth": {
    "providers": {
      "anonymous": true,
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "EasyRent",
        "supportEmail": "daki.tle.26@gmail.com"
      }
    }
  }
}
