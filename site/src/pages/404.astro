---
// site/src/pages/404.astro
//
// Firebase Hosting sert automatiquement `404.html` (build.format 'file') pour
// tout chemin inconnu, avec le statut HTTP 404. Sans elle, les visiteurs et
// les explorateurs tombent sur la page d'erreur générique de Firebase.
// noindex : une page d'erreur n'a rien à faire dans un index.
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Page introuvable — Baillan"
  description="Cette page n'existe pas ou a été déplacée."
  noindex
>
  <article class="prose">
    <h1>Page introuvable</h1>
    <p>
      Cette page n'existe pas ou a été déplacée. Vous pouvez revenir à
      <a href="/">l'accueil</a> ou consulter la <a href="/faq">FAQ</a>.
    </p>
  </article>
</BaseLayout>

<style>
  .prose { max-width: 42rem; padding: 3rem 0; }
  .prose h1 { font-size: clamp(1.8rem, 4vw, 2.4rem); margin: 0 0 1.5rem; }
  .prose p { color: var(--color-ink-muted); }
  .prose a { color: var(--color-olive); }
</style>
