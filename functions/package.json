{
  "name": "easyrent-functions",
  "version": "0.1.0",
  "description": "Cloud Functions backend for EasyRent (Firestore callables, triggers, scheduled jobs).",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "lint": "eslint --ext .ts src",
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "cd .. && npx -y firebase-tools@13 emulators:exec --only firestore --project demo-easyrent \"npm --prefix functions run test:rules:inner\"",
    "test:rules:inner": "vitest run --config vitest.rules.config.ts"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.0.1",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.29.1",
    "firebase": "^12.15.0",
    "firebase-functions-test": "^3.4.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
